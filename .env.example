# ── FraPP + G.O.D.A.I. Environment Variables ─────────────────────────────────
# Copy to .env and fill in production values before deploying.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
ENV=production                        # dev | staging | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ── Auth (REQUIRED in production) ─────────────────────────────────────────────
API_KEY=change-me-to-a-random-secret  # X-API-Key header value for all API calls
SECRET_KEY=change-me-to-32-char-rand  # Used for JWT signing (Sprint 2)

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite:///./frapp.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/frapp

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Use ["*"] only for dev.
CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Required for AnthropicProvider (cloud LLM)
# LLAMACPP_MODEL_PATH=/opt/models/phi-3-mini.Q4_K_M.gguf  # Local LLM (optional)
# OLLAMA_URL=http://localhost:11434    # Ollama server URL (optional)

# ── Redis (Sprint 2 — distributed rate limiting) ──────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Europe/Berlin
